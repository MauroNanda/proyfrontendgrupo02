
FROM node:22.22.3-alpine AS build

WORKDIR /app

COPY package*.json ./
COPY scripts/verificar-origen-dependencias.cjs ./scripts/
# Verifica el unico origen externo admitido antes de instalar desde el lockfile.
RUN node scripts/verificar-origen-dependencias.cjs && npm ci --allow-remote=root

COPY . .

RUN npm run build -- --configuration production

# La imagen final sirve archivos compilados; no necesita Node ni el compilador Angular.
FROM nginx:1.30.0-alpine

COPY --from=build /app/dist/convoca-frontend/browser /usr/share/nginx/html

COPY infra/nginx.production.conf /etc/nginx/conf.d/default.conf

# El puerto del navegador lo publica Compose; EXPOSE solo lo documenta.
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
